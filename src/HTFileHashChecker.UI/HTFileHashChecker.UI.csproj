<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>HTFileHashChecker</AssemblyName>
    <RootNamespace>HTFileHashChecker.UI</RootNamespace>
    <ApplicationIcon>..\..\assets\icons\htfilehashchecker.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <StartupObject>HTFileHashChecker.UI.Program</StartupObject>
    <AssemblyTitle>HT File Hash Checker</AssemblyTitle>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\HTFileHashChecker.Core\HTFileHashChecker.Core.csproj" />
    <ProjectReference Include="..\HTFileHashChecker.Windows\HTFileHashChecker.Windows.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="HTFileHashChecker.Tests" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="..\..\assets\branding\ht_logo.png" LogicalName="HTFileHashChecker.UI.ht_logo.png" />
    <EmbeddedResource Include="..\..\assets\branding\ht_logo_64.png" LogicalName="HTFileHashChecker.UI.ht_logo_64.png" />
    <EmbeddedResource Include="..\..\assets\icons\htfilehashchecker.ico" LogicalName="HTFileHashChecker.UI.app.ico" />
  </ItemGroup>
</Project>
